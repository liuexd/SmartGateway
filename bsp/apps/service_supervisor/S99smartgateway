#!/bin/sh
#
# S99smartgateway - init 启动脚本（Pinned /etc/inittab + 运行时启停标记）
#
# 部署位置：/etc/init.d/S99smartgateway
#
# ============================================================
# 两层结构与签名清单约束
# ============================================================
#
#   SysV / BusyBox init
#       └── service_supervisor_run (由 inittab respawn 条目托管)
#               └── exec service_supervisor -> smart_gateway
#
# /etc/inittab 属于 G2-R3C / G3 签名清单保护的 15 项只读关键文件之一，
# 启动/停止期间严禁增删或改写 /etc/inittab，以免破坏摘要导致 14/15 漂移。
#
# 启停机制：
#   - stop：停掉 Gateway，写入运行时停止标记 $STOP_FLAG，随后停止 supervisor；
#           init 拉起的新一轮 service_supervisor_run 检测到 $STOP_FLAG 后保持休眠，
#           既不会拉起 supervisor，也不会触发 sysvinit 快速重启节流（MAXSPAWN）。
#   - start：校验 inittab respawn 条目完整（只读检查，绝不修改），删除 $STOP_FLAG，
#           等待 init 托管的 service_supervisor_run exec 拉起 supervisor 并启动 Gateway。
#   - 崩溃自愈：运行态无 $STOP_FLAG，supervisor 意外崩溃退出后 init 立即重新拉起（ppid=1）。
#
set -e

NAME=smartgateway
ROOT=${SMARTGATEWAY_ROOT:-/opt/smartgateway}
BIN="$ROOT/bin/service_supervisor"
RUN_DIR="$ROOT/run"
SOCK="$RUN_DIR/supervisor.sock"
LOG="$ROOT/logs/supervisor.log"
INITTAB=${SMARTGATEWAY_INITTAB:-/etc/inittab}
INIT_PID=${SMARTGATEWAY_INIT_PID:-1}

if [ -n "${SMARTGATEWAY_STOP_FLAG:-}" ]; then
    STOP_FLAG="$SMARTGATEWAY_STOP_FLAG"
elif [ "$ROOT" = "/opt/smartgateway" ] && [ -d /run ] && [ -w /run ]; then
    STOP_FLAG="/run/smartgateway.disabled"
else
    STOP_FLAG="$RUN_DIR/supervisor.disabled"
fi

RESPAWN_MATCH="^[^#]*:respawn:.*service_supervisor"

say() { printf '%s\n' "$*"; }

fail() {
    printf 'FAIL: %s\n' "$*" >&2
    exit 1
}

mkdir -p "$RUN_DIR" "$ROOT/logs" "$(dirname "$STOP_FLAG")"

# supervisor 是否在监听 —— 唯一可信的判定。
supervisor_up() {
    [ -S "$SOCK" ] || return 1
    "$BIN" status --root "$ROOT" >/dev/null 2>&1
}

# 本 ROOT 的 supervisor 进程（忽略 service_supervisor_run 包装进程）。
supervisor_pids() {
    for p in /proc/[0-9]*; do
        e=$(readlink "$p/exe" 2>/dev/null) || continue
        case "$e" in
            */service_supervisor) ;;
            *) continue ;;
        esac

        cmd=$(tr '\0' ' ' < "$p/cmdline" 2>/dev/null) || continue
        case "$cmd" in
            *"run --root $ROOT"*) echo "${p#/proc/}" ;;
        esac
    done
}

# 停止所有本 ROOT 的 supervisor，返回后保证一个都不剩。
kill_all_supervisors() {
    rounds=0

    while [ $rounds -lt 80 ]; do
        pids=$(supervisor_pids)
        [ -z "$pids" ] && return 0

        for pid in $pids; do
            kill -TERM "$pid" 2>/dev/null || true
        done

        sleep 0.1
        rounds=$((rounds + 1))
    done

    pids=$(supervisor_pids)
    if [ -n "$pids" ]; then
        say "WARN: SIGTERM 未生效，使用 SIGKILL"

        for pid in $pids; do
            kill -KILL "$pid" 2>/dev/null || true
        done

        rounds=0
        while [ $rounds -lt 30 ]; do
            [ -z "$(supervisor_pids)" ] && return 0
            sleep 0.1
            rounds=$((rounds + 1))
        done
    fi

    return $([ -z "$(supervisor_pids)" ] && echo 0 || echo 1)
}

case "$1" in
start)
    say "Starting $NAME"

    [ -x "$BIN" ] || fail "$BIN not found or not executable"
    [ -f "$ROOT/service.conf" ] || fail "$ROOT/service.conf not found"
    grep -q "$RESPAWN_MATCH" "$INITTAB" 2>/dev/null || \
        fail "respawn entry missing in $INITTAB (refusing to mutate signed $INITTAB)"

    # 解除运行时停止门闩，允许 init 托管的 service_supervisor_run 恢复执行 supervisor
    rm -f "$STOP_FLAG"

    if supervisor_up; then
        say "supervisor already running"
    else
        i=0
        while [ $i -lt 100 ]; do
            supervisor_up && break
            if [ $i -eq 20 ]; then
                # 兜底：若 init 尚未加载或条目尚未启动，仅发送 HUP 触发重读（不改动文件）
                kill -HUP "$INIT_PID" 2>/dev/null || true
            fi
            sleep 0.1
            i=$((i + 1))
        done

        if ! supervisor_up; then
            say "FAIL: $INITTAB 中 respawn 条目存在，但 init 未能在 10s 内拉起 supervisor"
            say "      检查：1) $BIN 可执行  2) $ROOT/bin/service_supervisor_run 可执行"
            say "            3) $ROOT/service.conf 存在  4) $LOG 中的错误"
            fail "$NAME did not become ready via respawn"
        fi

        say "supervisor started (respawn)"
    fi

    if "$BIN" start --root "$ROOT" >>"$LOG" 2>&1; then
        say "gateway started"
    else
        say "WARN: gateway did not start; see $LOG"
    fi

    say "$NAME started"
    ;;

stop)
    say "Stopping $NAME"

    # 顺序：
    #   1. 先停 Gateway（让 supervisor 走正常收尾）
    #   2. 写入运行时停止标记 $STOP_FLAG（不改动 /etc/inittab）
    #   3. 停止 supervisor，init 随后拉起的包装脚本见 $STOP_FLAG 会保持暂停
    if supervisor_up; then
        "$BIN" stop --root "$ROOT" >>"$LOG" 2>&1 || true
    fi

    : > "$STOP_FLAG"

    kill_all_supervisors || true

    rm -f "$SOCK"

    if [ -n "$(supervisor_pids)" ]; then
        fail "$NAME still running after stop"
    fi

    say "$NAME stopped (runtime stop flag set; $INITTAB unchanged)"
    ;;

restart)
    "$0" stop
    sleep 1
    "$0" start
    ;;

status)
    if supervisor_up; then
        say "supervisor: running"

        for pid in $(supervisor_pids); do
            ppid=$(awk '{print $4}' "/proc/$pid/stat" 2>/dev/null || echo "?")
            say "supervisor: pid=$pid ppid=$ppid"
        done

        "$BIN" status --root "$ROOT" 2>/dev/null | \
            sed 's/^/gateway: /' || say "gateway: unknown"
    else
        say "supervisor: stopped"
        say "gateway: unknown (no supervisor)"

        if [ -f "$STOP_FLAG" ]; then
            say "NOTICE: 服务已手动停止（$STOP_FLAG），崩溃自愈当前暂停"
            say "        执行 '$0 start' 恢复"
        elif ! grep -q "$RESPAWN_MATCH" "$INITTAB" 2>/dev/null; then
            say "NOTICE: $INITTAB 中缺少 respawn 条目，崩溃自愈当前不可用"
        fi

        exit 1
    fi
    ;;

*)
    echo "Usage: $0 {start|stop|restart|status}" >&2
    exit 1
    ;;
esac
