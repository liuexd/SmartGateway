# SmartGateway-BSP G3 Kernel Trimming Fragment (applied on top of 100ask_imx6ull_defconfig)
# Preserves all BSP drivers, USB ADB (ConfigFS FunctionFS), FEC/WiFi, eMMC, ext4, Watchdog, Crypto, Perf.

# --- Theme 1: Single-SoC i.MX6ULL & UP Optimization ---
# CONFIG_SOC_IMX5 is not set
# CONFIG_SOC_IMX50 is not set
# CONFIG_SOC_IMX53 is not set
# CONFIG_SOC_IMX6Q is not set
# CONFIG_SOC_IMX6SL is not set
# CONFIG_SOC_IMX6SX is not set
# CONFIG_SOC_IMX6SLL is not set
# CONFIG_SOC_IMX7 is not set
# CONFIG_SOC_IMX7D is not set
# CONFIG_SOC_IMX7ULP is not set
# CONFIG_SOC_VF610 is not set
# CONFIG_SMP is not set

# --- Theme 2: Unused Graphics / DRM / GPU / HDMI / E-Ink / Camera / Sound ---
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_LOGO is not set
# CONFIG_BACKLIGHT_LCD_SUPPORT is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_SOC_CAMERA is not set
# CONFIG_SOUND is not set
# CONFIG_SND is not set

# --- Theme 2b: Unused MXC GPU/IPU/PXP/Touchscreen/Camera/SIM ---
# CONFIG_INPUT_TOUCHSCREEN is not set
# CONFIG_MXC_GPU_VIV is not set
# CONFIG_MXC_IPU is not set
# CONFIG_MXC_PXP_V2 is not set
# CONFIG_MXC_PXP_V3 is not set
# CONFIG_MXC_PXP_CLIENT_DEVICE is not set
# CONFIG_MXC_MIPI_CSI2 is not set
# CONFIG_MXC_SIM is not set
# CONFIG_MXC_SIMv2 is not set
# CONFIG_BCMDHD is not set
# CONFIG_BCMDHD_SDIO is not set

# --- Theme 2c: Unused AMP M4 RPMSG & Android ION/Staging Bloat ---
# CONFIG_HAVE_IMX_RPMSG is not set
# CONFIG_RPMSG is not set
# CONFIG_RPMSG_VIRTIO is not set
# CONFIG_IMX_RPMSG_PINGPONG is not set
# CONFIG_IMX_RPMSG_TTY is not set
# CONFIG_GPIO_IMX_RPMSG is not set
# CONFIG_REGULATOR_PF1550_RPMSG is not set
# CONFIG_RTC_DRV_IMX_RPMSG is not set
# CONFIG_ION is not set
# CONFIG_ION_MXC is not set
# CONFIG_STAGING_MEDIA is not set
# CONFIG_STAGING is not set

# --- Theme 3: Remove Heavy Function Tracers & Dynamic Debug (Keep Perf + Kallsyms + Printk Time) ---
# CONFIG_FTRACE is not set
# CONFIG_FUNCTION_TRACER is not set
# CONFIG_FTRACE_SYSCALLS is not set
# CONFIG_FTRACE_MCOUNT_RECORD is not set
# CONFIG_DYNAMIC_DEBUG is not set
# CONFIG_DEBUG_PREEMPT is not set
# CONFIG_MAGIC_SYSRQ is not set
CONFIG_PERF_EVENTS=y
CONFIG_HW_PERF_EVENTS=y
CONFIG_KALLSYMS=y
CONFIG_PRINTK_TIME=y

# --- Theme 4: Remove Unused Raw MTD/NAND/Network Filesystems & Unused BT/WLAN Vendors ---
# CONFIG_MTD is not set
# CONFIG_UBIFS_FS is not set
# CONFIG_JFFS2_FS is not set
# CONFIG_NFS_FS is not set
# CONFIG_NFSD is not set
# CONFIG_CIFS is not set
# CONFIG_BTRFS_FS is not set
# CONFIG_XFS_FS is not set
# CONFIG_ISO9660_FS is not set
# CONFIG_AUTOFS4_FS is not set
# CONFIG_BT is not set
# CONFIG_CAN is not set
# CONFIG_WLAN_VENDOR_ATH is not set
# CONFIG_WLAN_VENDOR_ATMEL is not set
# CONFIG_WLAN_VENDOR_BROADCOM is not set
# CONFIG_WLAN_VENDOR_CISCO is not set
# CONFIG_WLAN_VENDOR_INTEL is not set
# CONFIG_WLAN_VENDOR_INTERSIL is not set
# CONFIG_WLAN_VENDOR_MARVELL is not set
# CONFIG_WLAN_VENDOR_MEDIATEK is not set
# CONFIG_WLAN_VENDOR_RALINK is not set
# CONFIG_WLAN_VENDOR_RSI is not set
# CONFIG_WLAN_VENDOR_ST is not set
# CONFIG_WLAN_VENDOR_TI is not set
# CONFIG_WLAN_VENDOR_ZYDAS is not set

# --- Theme 5: Mandatory Retention Assertions ---
CONFIG_SOC_IMX6=y
CONFIG_SOC_IMX6UL=y
CONFIG_SOC_IMX6ULL=y
CONFIG_IMX2_WDT=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_ESDHC_IMX=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_VFAT_FS=y
CONFIG_CONFIGFS_FS=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_FS=y
# CONFIG_USB_CONFIGFS_F_MIDI is not set
# CONFIG_USB_CONFIGFS_F_UVC is not set
# CONFIG_USB_CONFIGFS_F_PRINTER is not set
CONFIG_FEC=y
CONFIG_WLAN=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_GPIOLIB=y
CONFIG_GPIO_SYSFS=y
CONFIG_GPIO_MXC=y
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_IMX=y
CONFIG_SPI=y
CONFIG_SPI_IMX=y
CONFIG_SPI_SPIDEV=y
CONFIG_SERIAL_IMX=y
CONFIG_SERIAL_IMX_CONSOLE=y
CONFIG_MODULES=y
CONFIG_MODVERSIONS=y
CONFIG_CRYPTO_SHA256=y
