# SmartGateway G4 production SWUpdate configuration
# Shared by target Buildroot image and isolated host test build.
CONFIG_HAVE_DOT_CONFIG=y
CONFIG_SCRIPTS=y
CONFIG_HW_COMPATIBILITY=y
CONFIG_HW_COMPATIBILITY_FILE="/etc/hwrevision"
CONFIG_SW_VERSIONS_FILE="/etc/sw-versions"

# Empty paths cause SWUpdate to place runtime IPC sockets under $TMPDIR
# rather than colliding on fixed /tmp paths.
CONFIG_SOCKET_CTRL_PATH=""
CONFIG_SOCKET_PROGRESS_PATH=""
CONFIG_SOCKET_REMOTE_HANDLER_DIRECTORY="/tmp/"

# Bootloader writes are exclusively owned by sgw_bootctl (redundant U-Boot env).
# CONFIG_UBOOT is not set
CONFIG_BOOTLOADER_NONE=y
# CONFIG_BOOTLOADER_GRUB is not set
# CONFIG_BOOTLOADERHANDLER is not set

CONFIG_SSL_IMPL_OPENSSL=y
CONFIG_HASH_VERIFY=y
CONFIG_SIGNED_IMAGES=y
CONFIG_SIGALG_RAWRSA=y
# CONFIG_SIGALG_RSAPSS is not set
# CONFIG_SIGALG_CMS is not set
# CONFIG_ENCRYPTED_IMAGES is not set

# Disabled network/daemon surfaces in G4 local/verified image flow
# CONFIG_DOWNLOAD is not set
# CONFIG_SURICATTA is not set
# CONFIG_WEBSERVER is not set
# CONFIG_LUA is not set
# CONFIG_MTD is not set
# CONFIG_UBIVOL is not set
# CONFIG_RDIFFHANDLER is not set
# CONFIG_ARCHIVE is not set

# Parsers and required handlers
CONFIG_LIBCONFIG=y
CONFIG_PARSERROOT=""
CONFIG_JSON=y
CONFIG_RAW=y
CONFIG_SHELLSCRIPTHANDLER=y
